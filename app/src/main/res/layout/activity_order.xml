<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 1. 顶部筛选栏（固定在顶部，不滚动） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="2dp">

        <!-- 全部（默认选中） -->
        <TextView
            android:id="@+id/tv_order_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_round"
            android:backgroundTint="#000000"
            android:gravity="center"
            android:text="全部"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- 已完成 -->
        <TextView
            android:id="@+id/tv_order_completed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_card_round"
            android:backgroundTint="#F5F5F5"
            android:gravity="center"
            android:text="已完成"
            android:textColor="#000000"
            android:textSize="20sp"/>

        <!-- 未完成 -->
        <TextView
            android:id="@+id/tv_order_unfinished"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_card_round"
            android:backgroundTint="#F5F5F5"
            android:gravity="center"
            android:text="未完成"
            android:textColor="#000000"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- 2. 订单列表区域（可滚动，占满剩余空间） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/ll_order_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 订单示例1（未完成） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="上门家政服务"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <!-- 未完成标签 -->
                    <TextView
                        android:id="@+id/tv_order_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_round"
                        android:backgroundTint="#FF9900"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="未完成"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="订单号：20260302001"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="预约时间：2026-03-03 09:00"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥ 120.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FF0000"/>

                    <Button
                        android:id="@+id/btn_cancel_order1"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="auto"
                        android:background="@drawable/bg_card_round"
                        android:backgroundTint="#FF0000"
                        android:text="取消订单"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 订单示例2（已完成） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="上门问诊服务"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <!-- 已完成标签 -->
                    <TextView
                        android:id="@+id/tv_order_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_round"
                        android:backgroundTint="#00CC00"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="已完成"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="订单号：20260301002"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务时间：2026-03-01 14:00"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥ 80.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FF0000"/>

                    <Button
                        android:id="@+id/btn_evaluate_order2"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="auto"
                        android:background="@drawable/bg_card_round"
                        android:backgroundTint="#000000"
                        android:text="评价"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 订单示例3（未完成） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_round"
                android:padding="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="生活代买服务"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:id="@+id/tv_order_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_round"
                        android:backgroundTint="#FF9900"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="未完成"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="订单号：20260302003"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="预约时间：2026-03-04 10:00"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥ 50.00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FF0000"/>

                    <Button
                        android:id="@+id/btn_cancel_order3"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="auto"
                        android:background="@drawable/bg_card_round"
                        android:backgroundTint="#FF0000"
                        android:text="取消订单"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3. 底部导航栏（固定在最下方） -->
    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>
